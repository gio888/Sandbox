   "outputs": [],
   "source": [
    "import os\n",
    "import re"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "91df6337",
   "metadata": {},
   "outputs": [],
   "source": [
    "def get_last_10_characters_of_filename(filename):\n",
    "  extension_index = filename.rfind(\".\")\n",
    "  print(filename)\n",
    "  if extension_index == -1:\n",
    "    return filename\n",
    "  else:\n",
    "    return filename[extension_index - 10:]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "d6fddfe0",
   "metadata": {},
   "outputs": [],
   "source": [
    "def rename_files():\n",
    "  for filename in os.listdir('.'):\n",
    "    print(filename)\n",
    "    match = re.search(r\"^\\d{4}-\\d{2}-\\d{2}.*\", filename)\n",
    "    print(match)\n",
    "    if match:\n",
    "      new_filename = get_last_10_characters_of_filename(filename).replace(\" \", \"\") + filename\n",
    "      os.rename(os.path.join('.', filename), os.path.join('.', new_filename))"
   ]
  },
